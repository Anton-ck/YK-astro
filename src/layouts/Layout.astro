---
import '../styles/global.css';
import background from '/src/assets/hero/hero.webp';
import { Image } from 'astro:assets';
---

<!doctype html>
<html lang="ua">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Yilia Kovalenko Photographer</title>
  </head>
  <body>
    <header class="relative min-h-screen overflow-hidden">
      <Image
        src={background}
        alt="Hero"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover object-center"
      />

      <div
        class="container relative z-10 mx-auto mt-6 flex w-full flex-col items-center px-4 py-4 sm:px-6 md:flex-row md:items-start md:justify-between md:py-6"
      >
        <!-- Mobile Menu -->
        <div class="drawer drawer-start w-full md:hidden">
          <input
            id="mobile-menu-drawer"
            type="checkbox"
            class="drawer-toggle"
          />
          <div class="drawer-content flex w-full justify-start">
            <label
              for="mobile-menu-drawer"
              class="btn btn-ghost border border-white/25 text-white hover:bg-white/10"
              aria-label="Open menu"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                class="h-6 w-6 stroke-current"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </label>
          </div>
          <div class="drawer-side z-20">
            <label
              for="mobile-menu-drawer"
              aria-label="Close menu"
              class="drawer-overlay bg-transparent"></label>
            <ul
              class="menu min-h-full w-64 border-r border-white/25 bg-transparent p-6 text-white backdrop-blur-sm"
            >
              <li>
                <a href="/" class="font-antonio tracking-wide">Головна</a>
              </li>
              <li>
                <a href="#about" class="font-antonio tracking-wide">Про мене</a>
              </li>
              <li>
                <a href="#price" class="font-antonio tracking-wide"
                  >Прайс та умови</a
                >
              </li>
              <li>
                <a href="/" class="font-antonio tracking-wide">Портфоліо</a>
              </li>
              <li>
                <a href="/" class="font-antonio tracking-wide">Контакти</a>
              </li>
            </ul>
          </div>
        </div>

        <!-- End of mobile menu -->
        <nav aria-label="Main left" class="hidden md:block">
          <ul
            class="flex w-40 flex-col justify-center border-r border-white/25 pb-12 lg:w-56"
          >
            <li class="flex flex-col">
              <a
                href="#about"
                class="link link-hover py-4 font-antonio tracking-wide text-white lg:py-6"
                >Про мене</a
              >
              <div class="border-b border-white/25 w-full"></div>
            </li>
            <li class="flex flex-col">
              <a
                href="#price"
                class="link link-hover py-4 font-antonio tracking-wide text-white lg:py-6"
                >Прайс та умови</a
              >
              <div class="border-b border-white/25 w-full"></div>
            </li>
          </ul>
        </nav>
        <div
          class="mt-8 flex flex-col items-center justify-center px-2 text-center md:mt-0"
        >
          <h1
            class="font-antonio text-white opacity-25 tracking-wide text-4xl sm:text-6xl xl:text-8xl py-6 sm:py-8"
          >
            Yulia Kovalenko
          </h1>
          <p
            class="font-antonio text-white text-base tracking-wide opacity-50 sm:text-lg md:text-xl"
          >
            photographer
          </p>
        </div>

        <nav aria-label="Main right" class="hidden md:block">
          <ul
            class="flex w-40 flex-col justify-center border-l border-white/25 pb-12 lg:w-56"
          >
            <li class="flex flex-col items-end">
              <a
                href="/"
                class="link link-hover py-4 font-antonio tracking-wide text-white lg:py-6"
                >Портфоліо</a
              >
              <div class="border-b border-white/25 w-full"></div>
            </li>
            <li class="flex flex-col items-end">
              <a
                href="/"
                class="link link-hover py-4 font-antonio tracking-wide text-white lg:py-6"
                >Контакти</a
              >
              <div class="border-b border-white/25 w-full"></div>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer
      class="flex flex-col items-center justify-center gap-4 bg-neutral p-4 text-neutral-content sm:flex-row sm:gap-6"
    >
      <aside class="text-center sm:text-left">
        <p>© {new Date().getFullYear()} Studio D.A. All rights reserved</p>
      </aside>
      <nav class="flex items-center gap-5" aria-label="Social links">
        <a
          href="https://t.me/yuliiya_kovalenko"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Telegram"
          class="transition-opacity hover:opacity-70"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="34"
            height="34"
            viewBox="0 0 1000 1000"
            fill="currentColor"
            class="text-white"
          >
            <path
              d="M226.328419,494.722069 C372.088573,431.216685 469.284839,389.350049 517.917216,369.122161 C656.772535,311.36743 685.625481,301.334815 704.431427,301.003532 C708.567621,300.93067 717.815839,301.955743 723.806446,306.816707 C728.864797,310.92121 730.256552,316.46581 730.922551,320.357329 C731.588551,324.248848 732.417879,333.113828 731.758626,340.040666 C724.234007,419.102486 691.675104,610.964674 675.110982,699.515267 C668.10208,736.984342 654.301336,749.547532 640.940618,750.777006 C611.904684,753.448938 589.856115,731.588035 561.733393,713.153237 C517.726886,684.306416 492.866009,666.349181 450.150074,638.200013 C400.78442,605.66878 432.786119,587.789048 460.919462,558.568563 C468.282091,550.921423 596.21508,434.556479 598.691227,424.000355 C599.00091,422.680135 599.288312,417.758981 596.36474,415.160431 C593.441168,412.561881 589.126229,413.450484 586.012448,414.157198 C581.598758,415.158943 511.297793,461.625274 375.109553,553.556189 C355.154858,567.258623 337.080515,573.934908 320.886524,573.585046 C303.033948,573.199351 268.692754,563.490928 243.163606,555.192408 C211.851067,545.013936 186.964484,539.632504 189.131547,522.346309 C190.260287,513.342589 202.659244,504.134509 226.328419,494.722069 Z"
            ></path>
          </svg>
        </a>
        <a
          href="https://www.instagram.com/yuliiya_kovalenko/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="transition-opacity hover:opacity-70"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            class="fill-current"
          >
            <path
              d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2m0 1.8A3.95 3.95 0 0 0 3.8 7.75v8.5A3.95 3.95 0 0 0 7.75 20.2h8.5a3.95 3.95 0 0 0 3.95-3.95v-8.5a3.95 3.95 0 0 0-3.95-3.95h-8.5M17.2 6.15a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1M12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10m0 1.8a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 0 0 0-6.4z"
            ></path>
          </svg>
        </a>
      </nav>
    </footer>
  </body>
</html>
