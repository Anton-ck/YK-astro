---
const contacts = [
  {
    href: 'https://t.me/yuliiya_kovalenko',
    label: 'Telegram',
    handle: '@yuliiya_kovalenko',
  },
  {
    href: 'https://www.instagram.com/yuliiya_kovalenko/',
    label: 'Instagram',
    handle: '@yuliiya_kovalenko',
  },
  {
    href: '+380973336902',
    label: 'Telephone',
    handle: '097 333 69 02',
  },
] as const;
---

<section
  id="contacts"
  class="container mx-auto flex-initial px-4 py-10 md:py-16"
>
  <div
    class="mx-auto flex w-full max-w-7xl flex-col items-center gap-8 md:gap-12"
  >
    <h2
      class="font-antonio text-center text-2xl text-black md:text-3xl lg:text-4xl"
    >
      Contacts
    </h2>
    <div
      class="flex w-full flex-col items-center rounded-xl bg-gray-100 px-4 py-8 sm:px-6 sm:py-10 md:px-8 md:py-12"
    >
      <p
        class="font-antonio max-w-prose text-center text-base leading-7 text-black md:text-lg md:leading-8"
      >
        Для бронювання зйомки напишіть мені в Telegram або Instagram
      </p>
      <ul class="mt-8 flex w-full max-w-md flex-col gap-4">
        {
          contacts.map((contact) => (
            <li>
              <a
                href={
                  contact.label === 'Telephone'
                    ? `tel:${contact.href}`
                    : contact.href
                }
                target="_blank"
                rel="noopener noreferrer"
                class="font-antonio flex items-center justify-between rounded-xl bg-white px-5 py-4 text-black transition-opacity hover:opacity-70"
              >
                <span class="text-lg md:text-xl">{contact.label}</span>
                <span class="text-base text-black/70">{contact.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
