---
import { Image } from 'astro:assets';
import portrait from '/src/assets/price/portrait.webp';
import PricePortraitContent from '../content/price-portrait.md';
---

<section id="price" class="container mx-auto flex-initial px-4 py-10 md:py-16">
  <div
    class="mx-auto flex w-full max-w-7xl flex-col gap-6 md:flex-row md:items-start md:gap-10"
  >
    <div class="w-full md:flex-1">
      <h2 class="font-antonio text-2xl text-black md:text-3xl lg:text-4xl pb-5">
        Пакет "Стандарт"
      </h2>

      <p class="font-antonio text-1xl text-black md:text-1xl lg:text-1xl pb-5">
        Жіночі і чоловічі, індивідуальні та парні студійні портрети, сімейна
        зйомка, фотосесія вагітності, прогулянкова фотосесія, Love story.
      </p>
      <p class="font-antonio text-2xl text-black md:text-2xl lg:text-2xl pb-5">
        1800 грн/година
      </p>
      <div
        class="prose prose-neutral mt-4 max-w-prose text-base leading-7 md:leading-8"
      >
        <PricePortraitContent />
      </div>
    </div>
    <Image
      src={portrait}
      alt="Yulia Kovalenko Photographer Cherkassy"
      fetchpriority="high"
      class="h-auto w-full shrink-0 rounded-xl object-cover object-center md:w-[45%] lg:w-[40%]"
      width={470}
    />
  </div>
</section>
